generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  verifier
  operator
}

enum ApplicationStatus {
  PENDING_VERIFIER
  REJECTED_BY_VERIFIER
  PENDING_OPERATOR
  APPLIED_ON_CRS
  APPLIED_ON_CSC
  REJECTED_BY_OPERATOR
  COMPLETED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @unique
  role          String   // "verifier" | "operator"
  facility      String
  password      String
  isActive      Boolean  @default(true) @map("is_active")
  authorityName String?  @map("authority_name")
  designation   String?
  contactNumber String?  @map("contact_number")
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([username])
  @@index([facility])
  @@index([isActive])
  @@map("cert_users")
}

model Application {
  id                String            @id @default(uuid()) @db.Uuid
  applicationNumber String            @unique @map("application_number")
  facility          String
  status            ApplicationStatus @default(PENDING_VERIFIER)
  certificateUrl    String?           @map("certificate_url")
  remarks           String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  child             ChildDetail?
  parents           ParentDetail?
  informant         InformantDetail?

  @@index([facility])
  @@index([status])
  @@index([createdAt])
  @@map("applications")
}

model ChildDetail {
  id                String      @id @default(uuid()) @db.Uuid
  applicationId     String      @unique @map("application_id") @db.Uuid
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name              String
  dateOfBirth       DateTime    @map("date_of_birth")
  gender            String
  adharNumber       String?     @map("adhar_number")
  adharCardUrl      String?     @map("adhar_card_url")
  weight            Float?
  deliveryAttention String?     @map("delivery_attention")
  deliveryMethod    String?     @map("delivery_method")
  pregnancyDuration Int?        @map("pregnancy_duration")
  placeOfBirth      String      @map("place_of_birth")

  // Birth Place Address
  birthPlotNumber   String?     @map("birth_plot_number")
  birthMohalla      String?     @map("birth_mohalla")
  birthVillage      String      @map("birth_village")
  birthWardNumber   String?     @map("birth_ward_number")
  birthSubDistrict  String      @map("birth_sub_district")
  birthBlock        String?     @map("birth_block")
  birthDistrict     String      @map("birth_district")
  birthState        String      @map("birth_state")
  birthPinCode      String      @map("birth_pin_code")
  birthPostOffice   String?     @map("birth_post_office")

  @@map("child_details")
}

model ParentDetail {
  id                   String      @id @default(uuid()) @db.Uuid
  applicationId        String      @unique @map("application_id") @db.Uuid
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Mother
  motherName           String      @map("mother_name")
  motherAdhar          String      @map("mother_adhar")
  motherMobile         String      @map("mother_mobile")
  motherEmail          String?     @map("mother_email")
  motherAdharCardUrl   String?     @map("mother_adhar_card_url")

  // Father
  fatherName           String      @map("father_name")
  fatherAdhar          String      @map("father_adhar")
  fatherMobile         String      @map("father_mobile")
  fatherEmail          String?     @map("father_email")
  fatherAdharCardUrl   String?     @map("father_adhar_card_url")

  // Present Address
  presentPlotNumber    String?     @map("present_plot_number")
  presentMohalla       String?     @map("present_mohalla")
  presentVillage       String      @map("present_village")
  presentWardNumber    String?     @map("present_ward_number")
  presentSubDistrict   String      @map("present_sub_district")
  presentBlock         String?     @map("present_block")
  presentDistrict      String      @map("present_district")
  presentState         String      @map("present_state")
  presentPinCode       String      @map("present_pin_code")
  presentPostOffice    String?     @map("present_post_office")

  // Permanent Address
  permPlotNumber       String?     @map("perm_plot_number")
  permMohalla          String?     @map("perm_mohalla")
  permVillage          String      @map("perm_village")
  permWardNumber       String?     @map("perm_ward_number")
  permSubDistrict      String      @map("perm_sub_district")
  permBlock            String?     @map("perm_block")
  permDistrict         String      @map("perm_district")
  permState            String      @map("perm_state")
  permPinCode          String      @map("perm_pin_code")
  permPostOffice       String?     @map("perm_post_office")

  @@map("parent_details")
}

model InformantDetail {
  id                   String      @id @default(uuid()) @db.Uuid
  applicationId        String      @unique @map("application_id") @db.Uuid
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name                 String
  adharNumber          String?     @map("adhar_number")
  adharCardUrl         String?     @map("adhar_card_url")
  mobileNumber         String      @map("mobile_number")
  email                String?
  providedInformation  Boolean     @default(false) @map("provided_information")

  // Informant Address
  informantPlotNumber  String?     @map("informant_plot_number")
  informantVillage     String      @map("informant_village")
  informantWardNumber  String?     @map("informant_ward_number")
  informantSubDistrict String      @map("informant_sub_district")
  informantBlock       String?     @map("informant_block")
  informantDistrict    String      @map("informant_district")
  informantState       String      @map("informant_state")
  informantPinCode     String      @map("informant_pin_code")
  informantPostOffice  String?     @map("informant_post_office")

  // Mother Address at Birth
  motherCity           String      @map("mother_city")
  motherSubDistrict    String      @map("mother_sub_district")
  motherBlock          String?     @map("mother_block")
  motherDistrict       String      @map("mother_district")
  motherState          String      @map("mother_state")
  motherPinCode        String      @map("mother_pin_code")
  motherPostOffice     String?     @map("mother_post_office")

  // Socio-economic / Statistical
  motherReligion       String      @map("mother_religion")
  fatherReligion       String      @map("father_religion")
  motherLiteracy       String?     @map("mother_literacy")
  fatherLiteracy       String?     @map("father_literacy")
  motherProfession     String?     @map("mother_profession")
  fatherProfession     String?     @map("father_profession")
  motherAgeAtMirrage   Int?        @map("mother_age_at_marriage")
  motherAgeAtChildBirth Int?       @map("mother_age_at_child_birth")
  motherChildNumber    Int?        @map("mother_child_number")
  relationToChild      String?     @map("relation_to_child")
  declarationAccepted  Boolean     @default(false) @map("declaration_accepted")

  @@map("informant_details")
}

model SubDivision {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  nameHi      String   @map("name_hi")
  displayName String   @map("display_name")
  district    String   @default("Madhubani")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  blocks      Block[]

  @@map("sub_divisions")
}

model Block {
  id            String      @id @default(uuid()) @db.Uuid
  code          String
  name          String
  nameHi        String      @map("name_hi")
  displayName   String      @map("display_name")
  subDivisionId String      @map("sub_division_id") @db.Uuid
  subDivision   SubDivision @relation(fields: [subDivisionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([subDivisionId, name])
  @@index([subDivisionId])
  @@map("blocks")
}

model PostOffice {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  pincode   String
  district  String   @default("MADHUBANI")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pincode, name])
  @@index([pincode])
  @@map("post_offices")
}

model OtpVerification {
  id                String   @id @default(uuid()) @db.Uuid
  applicationNumber String   @map("application_number")
  email             String
  otp               String
  expiresAt         DateTime @map("expires_at")
  attempts          Int      @default(0)
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([applicationNumber])
  @@index([email])
  @@map("otp_verifications")
}

model Facility {
  id          String   @id @default(uuid()) @db.Uuid
  sr          Int?
  district    String   @default("Madhubani")
  block       String
  name        String   @unique
  rawName     String?  @map("raw_name")
  type        String
  category    String?  @default("NA")
  categoryKey String?  @map("category_key")
  username    String?  @unique
  pin         String?
  phone       String?
  altPhone    String?  @map("alt_phone")
  emergency   String?  @default("102 / 104")
  email       String?  @default("cs-madhubani-bih@gov.in")
  address     String?
  timing      String?  @default("24x7 Emergency & Maternity / 9 AM - 5 PM Registry")
  features    String[] @default([])
  icon        String?
  tag         String?
  level       String?
  badgeColor  String?  @map("badge_color")
  badgeBg     String?  @map("badge_bg")
  badgeBorder String?  @map("badge_border")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([block])
  @@index([type])
  @@index([categoryKey])
  @@index([pin])
  @@index([isActive])
  @@map("facilities")
}

