# ==============================================================================
# Birth Certificate Portal — Madhubani District, Government of Bihar
# Environment Configuration Template (.env.example)
# Copy this file to .env.local and fill in your credentials
# ==============================================================================

# Database Configuration (PostgreSQL — Bihar SDC / Local)
DATABASE_URL="postgresql://<username>:<password>@<sdc_host_or_localhost>:5432/birthreg?schema=public&sslmode=prefer"

# Authentication & Security (JWT)
JWT_SECRET=your_super_secret_random_hex_string_here
JWT_EXPIRES=1d

# Application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cloudinary Configuration (Certificate Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP Notifications (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
